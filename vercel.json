{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sharpbricklaying.com.au"
        }
      ],
      "destination": "https://sharpbricklaying.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/partners/",
      "permanent": true
    },
    {
      "source": "/careers",
      "destination": "/careers/",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/articles/wa-brick-shortage",
      "destination": "/articles/wa-brick-shortage/",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    }
  ]
}
